# Lysa Plan — Environment Configuration Example
# Copy this file to .env: cp .env.example .env

# ==============================================================================
# 1. LOCAL & OFFLINE PRIVACY MODE (OLLAMA / LM STUDIO / VLLM)
# ==============================================================================
# When running locally with Ollama or LM Studio, no external API keys are required.
# All inferences, codebase inspection, and consensus execution stay 100% on your machine.
OLLAMA_BASE_URL="http://localhost:11434/v1"

# ==============================================================================
# 2. OPTIONAL CLOUD MODEL API KEYS
# ==============================================================================
# You can set these in .env or configure them dynamically in the browser UI (Keys modal).
# Keys configured in the browser UI are stored in local browser localStorage and take precedence.
DEEPSEEK_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# ==============================================================================
# 3. SERVER CONFIGURATION
# ==============================================================================
PORT=3000
APP_URL="http://localhost:3000"
